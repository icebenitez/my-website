---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { formatDate } from "../utils/locale";
import { toDate } from "../utils/date";

interface Props {
	project: ContentEntry<InferCollectionData<"projects">>;
	tags?: Array<{ slug: string; label: string }>;
	variant?: "card" | "feature";
	headingLevel?: 2 | 3;
	priority?: boolean;
}

const {
	project,
	tags = [],
	variant = "card",
	headingLevel = 2,
	priority = false,
} = Astro.props;

const Heading = `h${headingLevel}` as const;
const href = `/projects/${project.id}`;
const titleId = `project-${variant}-${project.id}`;
const title = project.data.title || "Untitled";
const date = toDate(project.data.date) ?? toDate(project.data.publishedAt);
const visibleTags = tags.slice(0, 3);

const sizes = {
	card: "(min-width: 1080px) 360px, (min-width: 700px) 45vw, 100vw",
	feature: "(min-width: 900px) 640px, 100vw",
}[variant];
---

<article class:list={["project", `project--${variant}`]}>
	<a href={href} class="project__media" tabindex="-1" aria-hidden="true">
		{
			project.data.hero_image ? (
				<div class="project__image" {...project.edit.hero_image}>
					<Image image={project.data.hero_image} sizes={sizes} priority={priority} />
				</div>
			) : (
				<div class="project__placeholder" />
			)
		}
	</a>
	<div class="project__body">
		<a href={href} class="project__link" aria-labelledby={titleId}>
			<span class="project__meta">
				{date && (
					<time datetime={date.toISOString()}>{formatDate(date, "short")}</time>
				)}
				<span>Case study</span>
			</span>
			<Heading class="project__title" id={titleId} {...project.edit.title}>
				{title}
			</Heading>
			{
				project.data.summary && (
					<p class="project__summary" {...project.edit.summary}>
						{project.data.summary}
					</p>
				)
			}
		</a>
		{
			(visibleTags.length > 0 || project.data.github_link || project.data.web_link) && (
				<div class="project__footer">
					{visibleTags.length > 0 && (
						<ul class="chips project__tags" aria-label="Tags">
							{visibleTags.map((tag) => (
								<li>
									<a href={`/tag/${tag.slug}`} class="chip">
										{tag.label}
									</a>
								</li>
							))}
						</ul>
					)}
					{
						(project.data.github_link || project.data.web_link) && (
							<ul class="project__links">
								{project.data.github_link && (
									<li>
										<a
											href={project.data.github_link}
											target="_blank"
											rel="noopener noreferrer"
										>
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="1.75"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<path
													d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
												/>
												<path d="M9 18c-4.51 2-5-2-7-2"
												/>
											</svg>
											<span class="sr-only">GitHub: </span>GitHub
										</a>
									</li>
								)}
								{project.data.web_link && (
									<li>
										<a
											href={project.data.web_link}
											target="_blank"
											rel="noopener noreferrer"
										>
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="1.75"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
												<polyline points="15 3 21 3 21 9" />
												<line x1="10" x2="21" y1="14" y2="3" />
											</svg>
											<span class="sr-only">Live site: </span>Live site
										</a>
									</li>
								)}
							</ul>
						)
					}
				</div>
			)
		}
	</div>
</article>

<style>
	.project {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		transition:
			box-shadow var(--transition-base),
			outline-color var(--transition-fast);
	}

	.project:has(.project__link:focus-visible) {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}

	@supports selector(:has(*)) {
		.project__link:focus-visible {
			outline: none;
		}
	}

	.project__media {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: var(--radius-lg);
		background: var(--color-fill);
	}

	.project__media::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		outline: 1px solid var(--color-media-outline);
		outline-offset: -1px;
		pointer-events: none;
	}

	.project__image {
		height: 100%;
	}

	.project__image :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		object-fit: cover;
		transition: scale 500ms var(--ease-out);
	}

	.project:has(.project__link:hover, .project__media:hover)
		.project__image
		:global(img) {
		scale: 1.03;
	}

	.project__placeholder {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			circle,
			var(--color-border-strong) 1px,
			transparent 1.5px
		);
		background-size: 14px 14px;
		mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
	}

	.project__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}

	.project__link {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		color: inherit;
		text-decoration: none;
	}

	.project__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.project__meta > :not(:last-child)::after {
		content: "·";
		content: "·" / "";
		margin-inline-start: var(--spacing-2);
	}

	.project__title {
		font-size: var(--font-size-lg);
		line-height: var(--leading-snug);
		color: var(--color-text);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: transparent;
		text-underline-offset: 0.18em;
		transition: text-decoration-color var(--transition-fast);
	}

	.project__summary {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: var(--font-size-sm);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}

	.project__summary[data-emdash-editing] {
		display: block;
		-webkit-line-clamp: unset;
		overflow: visible;
	}

	.project__footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		margin-top: auto;
	}

	.project__tags {
		gap: var(--spacing-1);
	}

	.project__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		list-style: none;
	}

	.project__links a {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-1);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.project__links a:hover {
		color: var(--color-text);
	}

	.project__links svg {
		width: 15px;
		height: 15px;
	}

	.project--card {
		padding: var(--card-padding);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.project--card:has(.project__link:hover, .project__media:hover) {
		box-shadow: var(--shadow-card-hover);
	}

	.project--card:has(.project__link:focus-visible) {
		outline-offset: 3px;
	}

	.project--card .project__link {
		padding: var(--spacing-4) var(--spacing-3) var(--spacing-4);
	}

	.project--card .project__footer {
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-3);
		padding: 0 var(--spacing-3) var(--spacing-3);
	}

	.project--feature {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		padding: var(--card-padding);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.project--feature:has(.project__link:hover, .project__media:hover) {
		box-shadow: var(--shadow-card-hover);
	}

	.project--feature .project__media {
		aspect-ratio: 4 / 3;
	}

	.project--feature .project__body {
		justify-content: center;
		gap: var(--spacing-8);
		padding: clamp(1.5rem, 1rem + 2vw, 3rem);
	}

	.project--feature .project__link {
		gap: var(--spacing-4);
	}

	.project--feature .project__title {
		font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
		line-height: var(--leading-tight);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
	}

	.project--feature .project__summary {
		-webkit-line-clamp: 3;
		font-size: var(--font-size-lg);
	}

	.project--feature .project__footer {
		margin-top: 0;
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}

	@media (max-width: 900px) {
		.project--feature {
			grid-template-columns: minmax(0, 1fr);
		}

		.project--feature .project__media {
			aspect-ratio: 16 / 9;
		}

		.project--feature .project__body {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-4);
		}
	}
</style>
