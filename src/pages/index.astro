---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [{ entries: projects, projectsHint }, { entries: posts, postsHint }, settings] =
	await Promise.all([
		getEmDashCollection("projects", { orderBy: { date: "desc" }, limit: 3 }),
		getEmDashCollection("posts", { orderBy: { date: "desc" }, limit: 3 }),
		getSiteSettings(),
	]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsHint);
	Astro.cache.set(postsHint);
}

const tagEntryIds = [
	...projects.map((p) => p.data.id),
	...posts.map((p) => p.data.id),
];
const projectTags = await getTermsForEntries(
	"projects",
	projects.map((p) => p.data.id),
	"tag",
);
const postTags = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const socials = [
	{
		label: "GitHub",
		href: "https://github.com/icebenitez",
		paths: [
			"M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4",
			"M9 18c-4.51 2-5-2-7-2",
		],
	},
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/ice-benitez/",
		paths: [
			"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z",
			"M2 9h4v12H2z",
			"M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",
		],
	},
	{
		label: "Email",
		href: "mailto:icebenitez@gmail.com",
		paths: [
			"M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z",
			"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7",
		],
	},
];
---

<Base title={siteTitle} description={siteTagline}>
	<header class="band intro">
		<div class="frame home-intro">
			<div>
				<h1 class="intro__title">Product Engineer</h1>
				{siteTagline && <p class="intro__lead">{siteTagline}</p>}
			</div>
			<ul class="home-socials">
				{
					socials.map((s) => (
						<li>
							<a href={s.href} class="icon-btn" aria-label={s.label} {...s.label === "Email" ? {} : { target: "_blank", rel: "noopener noreferrer" }}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									{s.paths.map((d) => <path d={d} />)}
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</header>

	<section class="band section" aria-labelledby="home-works">
		<div class="frame">
			<div class="section-head">
				<h2 id="home-works" class="section-head__title">Works</h2>
				<a href="/projects" class="arrow-link">
					All projects<span class="sr-only"> page</span>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
					</svg>
				</a>
			</div>
			{
				projects.length === 0 ? (
					<p class="home-empty">Case studies will appear here soon.</p>
				) : (
					<div class="post-grid">
						{projects.map((project) => (
							<ProjectCard
								project={project}
								tags={(projectTags.get(project.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label }))}
								headingLevel={3}
							/>
						))}
					</div>
				)
			}
		</div>
	</section>

	<section class="band section" aria-labelledby="home-writing">
		<div class="frame">
			<div class="section-head">
				<h2 id="home-writing" class="section-head__title">Writing</h2>
				<a href="/posts" class="arrow-link">
					View all<span class="sr-only"> posts</span>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
					</svg>
				</a>
			</div>
			{
				posts.length === 0 ? (
					<p class="home-empty">No posts published yet.</p>
				) : (
					<div class="post-grid">
						{posts.map((post) => (
							<PostCard
								post={post}
								tags={(postTags.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label }))}
								headingLevel={3}
							/>
						))}
					</div>
				)
			}
		</div>
	</section>

	<section class="band section" aria-labelledby="home-contact">
		<div class="frame">
			<div class="home-contact">
				<h2 id="home-contact" class="section-head__title">Let's connect</h2>
				<p class="home-contact__text">
					I'm always happy to talk about thoughtful products, interesting
					engineering problems, and ways to work together.
				</p>
				<div class="home-contact__actions">
					<a href="/contact" class="btn btn--ghost btn--sm">Contact page</a>
					<a href="mailto:icebenitez@gmail.com" class="btn btn--sm">Email me</a>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.home-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: var(--spacing-6) var(--spacing-8);
	}

	.home-socials {
		display: flex;
		gap: var(--spacing-2);
		list-style: none;
		margin-block-end: var(--spacing-2);
	}

	.home-empty {
		color: var(--color-text-secondary);
	}

	.home-contact {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-4);
		max-width: 34rem;
		margin-inline: auto;
		padding-block: var(--spacing-8);
		text-align: center;
	}

	.home-contact__text {
		color: var(--color-text-secondary);
	}

	.home-contact__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--spacing-3);
	}

	@media (max-width: 720px) {
		.home-intro {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-socials {
			justify-self: start;
			margin-block-end: 0;
		}
	}
</style>
