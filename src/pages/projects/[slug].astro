---
import {
	getEmDashEntry,
	getEntryTerms,
	getSeoMeta,
	decodeSlug,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../utils/locale";
import { toDate } from "../../utils/date";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: project, cacheHint } = await getEmDashEntry("projects", slug);

if (!project) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(project, {
	siteTitle: "Ice Benitez",
	siteUrl: Astro.url.origin,
	path: `/projects/${slug}`,
});

const date = toDate(project.data.date) ?? toDate(project.data.publishedAt);
const tags = project.data.terms?.tag ?? [];
---

<Base
	title={seo.title}
	description={seo.description ?? project.data.summary}
	type="article"
	publishedTime={date?.toISOString()}
	content={{ collection: "projects", id: project.data.id }}
>
	<article class="band section">
		<div class="frame project-article">
			<a href="/projects" class="arrow-link project-article__back">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="m15 18-6-6 6-6"></path>
				</svg>
				All projects
			</a>

			<header class="project-article__header">
				{
					date && (
						<time class="eyebrow" datetime={date.toISOString()}>
							{formatDate(date, "long")}
						</time>
					)
				}
				<h1 class="project-article__title" {...project.edit.title}>
					{project.data.title}
				</h1>
				{
					project.data.summary && (
						<p class="intro__lead" {...project.edit.summary}>
							{project.data.summary}
						</p>
					)
				}
				{
					tags.length > 0 && (
						<ul class="chips" aria-label="Tags">
							{tags.map((t) => (
								<li>
									<a href={`/tag/${t.slug}`} class="chip">
										{t.label}
									</a>
								</li>
							))}
						</ul>
					)
				}
				{
					(project.data.github_link || project.data.web_link) && (
						<ul class="project-article__links">
							{project.data.github_link && (
								<li>
									<a
										href={project.data.github_link}
										target="_blank"
										rel="noopener noreferrer"
										class="btn btn--ghost btn--sm"
									>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path
												d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
											/>
											<path d="M9 18c-4.51 2-5-2-7-2"></path>
										</svg>
										GitHub
									</a>
								</li>
							)}
							{project.data.web_link && (
								<li>
									<a
										href={project.data.web_link}
										target="_blank"
										rel="noopener noreferrer"
										class="btn btn--ghost btn--sm"
									>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
											<polyline points="15 3 21 3 21 9"></polyline>
											<line x1="10" x2="21" y1="14" y2="3"></line>
										</svg>
										Live site
									</a>
								</li>
							)}
						</ul>
					)
				}
			</header>

			{
				project.data.hero_image && (
					<figure class="project-article__media" {...project.edit.hero_image}>
						<Image image={project.data.hero_image} sizes="(min-width: 900px) 1200px, 100vw" priority />
					</figure>
				)
			}

			<div class="prose" data-post-content>
				<PortableText value={project.data.content} />
			</div>
		</div>
	</article>
</Base>

<style>
	.project-article {
		max-width: calc(var(--content-width) + 2 * var(--frame-padding));
	}

	.project-article__back {
		color: var(--color-text-secondary);
	}

	.project-article__header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-4);
		margin-block: var(--spacing-6) var(--spacing-8);
	}

	.project-article__title {
		font-size: var(--font-size-display);
		line-height: 1.05;
		max-width: 24ch;
	}

	.project-article__header .chips {
		margin-block: var(--spacing-2);
	}

	.project-article__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		list-style: none;
	}

	.project-article__media {
		margin-block: 0 var(--spacing-8);
	}

	.project-article__media :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-xl);
		outline: 1px solid var(--color-media-outline);
		outline-offset: -1px;
	}
</style>
