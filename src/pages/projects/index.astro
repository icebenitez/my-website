---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const { entries: projects, cacheHint } = await getEmDashCollection("projects", {
	orderBy: { date: "desc" },
	limit: 50,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"projects",
	projects.map((p) => p.data.id),
	"tag",
);
const projectsWithTags = projects.map((project) => ({
	project,
	tags: (tagsByEntry.get(project.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base title="Projects" description="Projects and case studies of products and systems I've built.">
	<header class="band intro">
		<div class="frame">
			<h1 class="intro__title">Projects</h1>
			<p class="intro__lead">
				A look at products and systems I've built, from problem to solution.
			</p>
		</div>
	</header>

	{
		projects.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">No projects yet</h2>
						<p class="empty-state__text">
							Case studies will appear here once published.
						</p>
					</div>
				</div>
			</section>
		) : (
			<section class="band section">
				<div class="frame">
					<div class="post-grid">
						{projectsWithTags.map(({ project, tags }) => (
							<ProjectCard project={project} tags={tags} headingLevel={2} />
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>
