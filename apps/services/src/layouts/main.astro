---
// apps/data/src/layouts/main.astro
import '../styles/global.css';
import { SITE_URL, MAIN_URL } from '../site';

const {
  title = 'Services | Ice Benitez',
  description = 'Product engineering services by Ice Benitez: SaaS products, custom backend systems, analytics dashboards and BI, automation.',
} = Astro.props;
const siteUrl = SITE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Prevent theme flash: apply dark class before any paint -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ice Benitez" />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ice Benitez — Services" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>

  <body class="antialiased">
    <header class="sticky top-0 z-50 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <div class="container mx-auto flex h-14 items-center justify-between px-4">
        <span class="font-bold">Ice Benitez — Services</span>
        <nav class="flex items-center space-x-6 text-sm font-medium">
          <a class="transition-colors hover:text-foreground/80" href={MAIN_URL}>icebenitez.com</a>
          <a class="transition-colors hover:text-foreground/80" href={`${MAIN_URL}/contact`}>Contact</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="border-t py-8">
      <div class="container mx-auto px-4 text-sm text-muted-foreground">
        <p>&copy; {new Date().getFullYear()} Ice Benitez. Part of <a class="underline" href={MAIN_URL}>icebenitez.com</a>.</p>
      </div>
    </footer>
  </body>
</html>
