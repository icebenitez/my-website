---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  date: string;
  heroImage?: string;
  githubLink?: string;
  webLink?: string;
}

const { title, description, tags, href, date, heroImage, githubLink, webLink } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl bg-card text-card-foreground shadow-xs ring-1 ring-foreground/10 transition-transform hover:-translate-y-2">
  <a href={href} class="block flex flex-col h-full">
    {heroImage && (
      <div class="aspect-video overflow-hidden bg-muted">
        <img src={heroImage} alt={title} class="h-full w-full object-cover transition-transform group-hover:scale-105" loading="lazy" />
      </div>
    )}
    <div class="flex flex-1 flex-col p-6">
      <time class="mb-2 text-xs text-muted-foreground" datetime={date}>{formattedDate}</time>
      <h3 class="mb-2 text-xl font-semibold">{title}</h3>
      <p class="mb-4 flex-1 text-sm text-muted-foreground">{description}</p>
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="inline-flex items-center rounded-md bg-muted px-2 py-1 text-xs font-medium ring-1 ring-inset ring-gray-500/10">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </a>

  {(githubLink || webLink) && (
    <div class="flex items-center gap-4 border-t px-6 py-4">
      {githubLink && (
        <a href={githubLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm hover:underline">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          GitHub
        </a>
      )}
      {webLink && (
        <a href={webLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm hover:underline">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" x2="21" y1="14" y2="3"/>
          </svg>
          Live Site
        </a>
      )}
    </div>
  )}
</article>
