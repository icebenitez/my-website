---
import MainLayout from '../../layouts/main.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.status === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<MainLayout title="Blog" description="Thoughts on product engineering, building software, and working with startups.">
  <main class="container mx-auto px-4 md:px-6">
    <section class="py-12 md:py-24 lg:py-32">
      <div class="container px-4 md:px-6">
        <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
          <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl">
            Blog
          </h1>
          <p class="mt-4 text-muted-foreground md:text-lg">
            Thoughts on product engineering, building software, and working with startups.
          </p>
        </div>

        {posts.length === 0 ? (
          <div class="mt-16 text-center text-muted-foreground">
            <p>No posts published yet. Check back soon.</p>
          </div>
        ) : (
          <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
            {posts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
                date={post.data.date.toISOString()}
              />
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</MainLayout>
