---
import MainLayout from '../../layouts/main.astro';
---

<MainLayout title="Contact" description="Get in touch to discuss projects, collaborations, or opportunities.">
  <main class="container mx-auto px-4 md:px-6">
    <section class="py-12 md:py-24 lg:py-32">
      <div class="mx-auto max-w-2xl px-4 text-center md:px-6">
        <div data-animate="fade-up">
          <p class="mb-3 text-sm font-medium text-primary">Available for projects</p>
          <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl">
            Start a conversation
          </h1>
          <p class="mx-auto mt-4 max-w-lg text-muted-foreground">
            Have a project in mind or want to explore working together? I'd love to hear from you.
          </p>
        </div>

        <div class="mt-10 space-y-4" data-animate-stagger>
          <a
            href="mailto:icebenitez@gmail.com"
            class="flex items-center justify-center gap-3 rounded-xl bg-card p-5 text-card-foreground shadow-xs ring-1 ring-foreground/10 transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span class="text-sm font-medium">icebenitez@gmail.com</span>
          </a>

          <a
            href="https://www.linkedin.com/in/ice-benitez/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 rounded-xl bg-card p-5 text-card-foreground shadow-xs ring-1 ring-foreground/10 transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
            <span class="text-sm font-medium">LinkedIn</span>
          </a>

          <a
            href="https://github.com/icebenitez"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 rounded-xl bg-card p-5 text-card-foreground shadow-xs ring-1 ring-foreground/10 transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
            <span class="text-sm font-medium">GitHub</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
