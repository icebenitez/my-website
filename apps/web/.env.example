# Copy to .env and adjust as needed. All vars are optional —
# the hardcoded defaults below are baked in as fallbacks.

# Canonical base URL of this app (also used at build time by astro.config.mjs)
PUBLIC_SITE_URL=https://icebenitez.com

# URL of the services subdomain (used by the main site's nav)
PUBLIC_SERVICES_URL=https://services.icebenitez.com

# URL of the blog subdomain (used by the main site's nav)
PUBLIC_BLOG_URL=https://blog.icebenitez.com
