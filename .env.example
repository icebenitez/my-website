# EmDash runtime encryption key (generated by create-emdash).
# Do not commit the production value; in production upload it as a secret:
#   npx wrangler secret put EMDASH_ENCRYPTION_KEY
EMDASH_ENCRYPTION_KEY=<paste-from-local-.env-or-npx-emdash-secrets-generate>

# Local dev uses the hardcoded defaults below; production values come from
# the Cloudflare dashboard/worker environment, not this file.
