{
  "name": "icebenitez-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:services": "npm run dev --workspace apps/services",
    "build": "npm run build --workspaces",
    "preview:web": "npm run preview --workspace apps/web",
    "preview:services": "npm run preview --workspace apps/services"
  }
}
